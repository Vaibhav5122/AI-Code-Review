# ==============================================================================
# DiffMind - Production & Local Environment Variables
# ==============================================================================

# 1. Database Connection (Neon Serverless PostgreSQL)
# For production on Vercel, use the pooled Neon connection string with ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Better Auth Configuration
# BETTER_AUTH_SECRET: Generate via `openssl rand -base64 32`
BETTER_AUTH_SECRET="your-32-byte-secret"
# BETTER_AUTH_URL: Production domain on Vercel (https://diffmind.vbxv.me)
# (In local development with ngrok: https://your-subdomain.ngrok-free.dev)
BETTER_AUTH_URL="https://diffmind.vbxv.me"

# 3. GitHub OAuth & App Configuration
# Found under GitHub Developer Settings -> GitHub Apps -> Your App
GITHUB_CLIENT_ID="Iv..."           # Client ID from GitHub App
GITHUB_CLIENT_SECRET="..."         # Client Secret generated in GitHub App
GITHUB_APP_NAME="diffmind"         # GitHub App Name / Slug (e.g. diffmind or diffmind-bot)
GITHUB_APP_ID="123456"             # Numeric App ID from GitHub App page
GITHUB_WEBHOOK_SECRET="..."        # Webhook secret set in GitHub App settings
# GITHUB_APP_PRIVATE_KEY: Generated RSA Private Key (.pem file downloaded from GitHub)
# On Vercel: Paste the entire content with quotes or with literal newlines
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# 4. Inngest Configuration
# In Local Dev: Set INNGEST_DEV=1 and run `npm run inngest:dev`
# On Vercel (Production): DO NOT set INNGEST_DEV! Instead, obtain keys from Inngest Cloud:
# - INNGEST_EVENT_KEY: Inngest Dashboard -> Event Keys
# - INNGEST_SIGNING_KEY: Inngest Dashboard -> Webhooks / Signing Keys
INNGEST_DEV=1
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# 5. OpenRouter LLM Configuration
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
# Model string (e.g. inclusionai/ling-3.0-flash:free, anthropic/claude-3.5-sonnet, deepseek/deepseek-chat)
REVIEW_MODEL="inclusionai/ling-3.0-flash:free"

# 6. Pinecone Vector DB Configuration
# API key from https://app.pinecone.io
PINECONE_INDEX="ai-code-review"
PINECONE_API_KEY="pcsk_..."
